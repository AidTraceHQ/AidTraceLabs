NODE_ENV=development
PORT=3001
# Optional. Leave empty for same-origin /api requests through the Vite dev proxy.
VITE_API_BASE_URL=
DATABASE_URL=postgresql://aidtrace:change-me@localhost:5432/aidtrace
POSTGRES_USER=aidtrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aidtrace
# For remote PostgreSQL, use sslmode=verify-full (append with & if a query already exists).
# DATABASE_URL=postgresql://aidtrace:change-me@db.example.com:5432/aidtrace?sslmode=verify-full
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
TEST_DATABASE_BRANCH=test
PRODUCTION_DATABASE_HOST=
SESSION_SECRET=replace-with-at-least-32-random-bytes
PSEUDONYM_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
PUBLIC_APP_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_STELLAR_NETWORK=testnet
HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
HORIZON_MAINNET_URL=https://horizon.stellar.org
ADMIN_WALLET=
